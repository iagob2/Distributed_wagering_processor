NODE_ENV=development
PORT=3000

# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=wagering_db

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAIN_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Identity Provider (Zitadel) — Seção 2: auth vale 0 pontos; default = NoopAuthGuard
IDP_ISSUER=http://localhost:8080
IDP_JWKS_URI=http://localhost:8080/oauth/v2/keys
IDP_CLIENT_ID=wagering-sa
IDP_CLIENT_SECRET=
IDP_PROJECT_ID=
