        "@nestjs/config": "^3.2.2",
        "@nestjs/core": "^10.3.9",
        "@nestjs/platform-express": "^10.3.9",
        "@nestjs/terminus": "^10.2.3",
        "bignumber.js": "^9.1.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "decimal.js": "^10.6.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
